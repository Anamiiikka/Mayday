# Copy to .env and fill in your own values. Never commit real secrets.

# Port the backend listens on
PORT=4000

# Origin allowed to call this backend (the Next.js dev server)
FRONTEND_ORIGIN=http://localhost:3000

# Neon Postgres connection string (create a free project at neon.tech)
NEON_DATABASE_URL=

# TrueForge server base URL (npx @truefoundry/trueforge)
TRUEFORGE_BASE_URL=http://localhost:8790

# Optional: when set, /mcp requires "Authorization: Bearer <MCP_TOKEN>".
# Configure the same token on the TrueForge MCP server connection.
MCP_TOKEN=

# Optional: when set, /api agent and demo routes require this bearer token.
# Leave empty for local use where the backend is only reachable from this machine.
OPERATOR_TOKEN=
